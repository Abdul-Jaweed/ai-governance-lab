# PostgreSQL (matches docker-compose.yml; host port 5433 to avoid clashing with a local 5432)
DATABASE_URL=postgresql+asyncpg://governance:governance@localhost:5433/governance

# Governance enforcement mode: "enforce" (block denied actions) or "observe" (record but allow)
GOVERNANCE_MODE=enforce

# Behavior when the recorder cannot persist an event: "fail_closed" (block) or "allow"
GOVERNANCE_ON_RECORDER_FAILURE=fail_closed

# OpenAI-compatible model used by the sandbox agent.
# Point OPENAI_BASE_URL at any OpenAI-compatible endpoint (OpenAI, Azure OpenAI, vLLM, Ollama, ...).
OPENAI_API_KEY=sk-replace-me
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
